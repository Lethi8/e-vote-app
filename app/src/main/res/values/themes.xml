<resources>
    <style name="Theme.Vota" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/vota_green</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/vota_mint</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">@color/vota_bg</item>
        <item name="android:navigationBarColor">@color/white</item>
    </style>

    <style name="Theme.Vota.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/vota_green</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_mark</item>
        <item name="postSplashScreenTheme">@style/Theme.Vota</item>
    </style>
</resources>